    {
      "parameters": {
        "jsCode": "const resp = $input.first().json;\nconst lista = resp.value || [];\nconst estado = $getWorkflowStaticData('global');\nconst desde = estado.ultimaTranscricao || new Date(Date.now() - 24 * 3600 * 1000).toISOString();\nconst novas = lista\n  .filter(t => t.createdDateTime > desde)\n  .sort((a, b) => a.createdDateTime.localeCompare(b.createdDateTime));\nif (novas.length) estado.ultimaTranscricao = novas[novas.length - 1].createdDateTime;\nreturn novas.map(t => ({ json: { id: t.id, meetingId: t.meetingId, createdDateTime: t.createdDateTime } }));"
      },
