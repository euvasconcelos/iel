    {
      "parameters": {
        "jsCode": "const meta = $('Montar prompt').first().json;\nconst resp = $input.first().json;\nconst bruto = resp?.choices?.[0]?.message?.content;\nif (!bruto) throw new Error('Resposta do LLM sem texto: ' + JSON.stringify(resp).slice(0, 300));\n\nlet r;\ntry {\n  r = JSON.parse(bruto.replace(/^```json\\s*|```$/g, '').trim());\n} catch (e) {\n  throw new Error('JSON inválido retornado pelo modelo: ' + bruto.slice(0, 300));\n}\nfor (const campo of ['titulo', 'resumo', 'decisoes', 'tarefas']) {\n  if (!(campo in r)) throw new Error('Campo obrigatório ausente: ' + campo);\n}\nr.riscos = r.riscos || [];\n\nconst esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst li = (arr) => arr.length ? '<ul>' + arr.map(x => '<li>' + esc(x) + '</li>').join('') + '</ul>' : '<p>Nenhum item.</p>';\nconst linhas = r.tarefas.map(t => '<tr><td>' + esc(t.descricao) + '</td><td>' + esc(t.responsavel) + '</td><td>' + esc(t.prazo) + '</td><td>' + esc(t.prioridade) + '</td></tr>').join('');\nconst tabela = r.tarefas.length\n  ? '<table border=\"1\" cellpadding=\"6\" cellspacing=\"0\" style=\"border-collapse:collapse\"><tr><th>Tarefa</th><th>Responsável</th><th>Prazo</th><th>Prioridade</th></tr>' + linhas + '</table>'\n  : '<p>Nenhuma tarefa identificada.</p>';\n\nconst html = '<h2>' + esc(r.titulo) + '</h2>'\n  + '<p><b>Arquivo:</b> ' + esc(meta.nomeArquivo) + ' | <b>Data:</b> ' + esc(meta.dataReuniao) + '</p>'\n  + '<h3>Resumo</h3><p>' + esc(r.resumo) + '</p>'\n  + '<h3>Decisões</h3>' + li(r.decisoes)\n  + '<h3>Tarefas</h3>' + tabela\n  + '<h3>Riscos</h3>' + li(r.riscos);\n\nconst ataTexto = [\n  'ATA DE REUNIÃO',\n  r.titulo,\n  'Origem: ' + meta.nomeArquivo + ' | Data: ' + meta.dataReuniao,\n  '',\n  'RESUMO',\n  r.resumo,\n  '',\n  'DECISÕES',\n  ...r.decisoes.map(d => '- ' + d),\n  '',\n  'TAREFAS',\n  ...r.tarefas.map(t => '- ' + t.descricao + ' | Responsável: ' + t.responsavel + ' | Prazo: ' + t.prazo + ' | Prioridade: ' + t.prioridade),\n  '',\n  'RISCOS',\n  ...r.riscos.map(x => '- ' + x)\n].join('\\n');\n\nreturn [{ json: { ...r, nomeArquivo: meta.nomeArquivo, dataReuniao: meta.dataReuniao, modeloUsado: resp.model, html, ataTexto } }];"
      },
