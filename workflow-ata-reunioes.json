    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const vtt = ($('Buscar conteúdo VTT').item.json.data || '').toString();\nconst reuniao = $input.item.json;\nconst meta = $('Filtrar novas transcrições').item.json;\nconst linhas = [];\nfor (const l of vtt.split(/\\r?\\n/)) {\n  const t = l.trim();\n  if (!t || t === 'WEBVTT' || /^\\d+$/.test(t) || /-->/.test(t) || /^NOTE/.test(t)) continue;\n  const m = t.match(/^<v ([^>]+)>(.*?)(<\\/v>)?$/);\n  linhas.push(m ? m[1] + ': ' + m[2].trim() : t.replace(/<[^>]+>/g, ''));\n}\nreturn { json: { data: linhas.join('\\n'), name: reuniao.subject || 'Reunião Teams', createdTime: meta.createdDateTime } };"
      },
