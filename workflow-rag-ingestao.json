      "id": "5b23e2b9-80c5-4fc7-9962-ba21b2a24f23",
      "name": "Transcrever (Groq Whisper)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        928,
        208
      ],
      "credentials": {
        "httpBearerAuth": {
