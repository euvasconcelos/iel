    {
      "parameters": {
        "jsCode": "const resp = $input.first().json;\nconst arq = $('Novo vídeo na pasta Treinamentos').first().json;\nconst segs = Array.isArray(resp.segments) ? resp.segments : [];\nif (!segs.length && !(resp.text || '').trim()) { throw new Error('Transcrição vazia: o áudio não tem fala reconhecível'); }\nconst nome = (arq.name || 'treinamento').replace(/\\.[^.]+$/, '');\nconst ferramenta = nome.split(/\\s+-\\s+|_/)[0].trim();\nconst data = (arq.createdTime || new Date().toISOString()).slice(0, 10);\nconst fmt = (s) => { const m = Math.floor(s / 60); const r = Math.floor(s % 60); return m + ':' + String(r).padStart(2, '0'); };\nconst LIMITE = 800;\nconst trechos = [];\nlet atual = null;\nfor (const s of segs) {\n  const t = (s.text || '').trim();\n  if (!t) continue;\n  if (!atual) atual = { inicio: s.start || 0, texto: '' };\n  atual.texto += (atual.texto ? ' ' : '') + t;\n  if (atual.texto.length >= LIMITE) { trechos.push(atual); atual = null; }\n}\nif (atual) trechos.push(atual);\nif (!trechos.length) trechos.push({ inicio: 0, texto: (resp.text || '').trim() });\nreturn trechos.map((t) => ({ json: { texto: t.texto, minuto: fmt(t.inicio), treinamento: nome, ferramenta, arquivo: arq.name, link: arq.webViewLink || '', data } }));"
      },
      "id": "a22ce507-4880-43aa-917d-6c2b554710f6",
      "name": "Montar trechos",
